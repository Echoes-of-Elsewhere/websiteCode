---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import { castMembers, qaQuestions } from '../data/cast';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Meet the Cast | Echoes of Elsewhere"
  description="Meet the players and Keeper behind Echoes of Elsewhere, an actual play podcast crossing Call of Cthulhu and Dungeons & Dragons."
>
  <Nav />

  <main id="main-content">
    <HeroSection portalFetchPriority="high" compact>
      <div class="eyebrow">The Table</div>
      <h1>Meet the Cast</h1>
      <p class="lede">
        The voices behind the story bring different perspectives to every world, system, and
        impossible choice.
      </p>
      <div class="hero-actions">
        <a class="button" href={base}>Back to Home</a>
        <a class="button secondary" href={`${base}#listen`}>Watch and listen</a>
      </div>
    </HeroSection>

    <section class="shell" id="cast">
      <div class="section-heading" data-reveal>
        <h2>The voices behind the echoes</h2>
      </div>
      <ul class="cast-grid mt-1-6" aria-label="Cast members">
        {castMembers.map((member, memberIndex) => (
          <li>
            <article class="card cast-card" data-reveal>
              {member.image ? (
                <img
                  class="avatar cast-portrait"
                  src={`${base.replace(/\/$/, '')}${member.image}`}
                  alt={`${member.name} portrait`}
                  width="90"
                  height="90"
                  loading="lazy"
                />
              ) : (
                <div class="avatar" aria-hidden="true">{member.name.slice(0, 1)}</div>
              )}
              <div class="cast-body">
                <div class="cast-heading">
                  <div>
                    <h3>{member.name}</h3>
                    <p class="role">{member.role}</p>
                  </div>
                  {member.appearanceCount && (
                    <span class="cast-count">{member.appearanceCount} episodes</span>
                  )}
                </div>
                {member.bio && <p class="bio">{member.bio}</p>}
                {member.qa && Object.keys(member.qa).length > 0 ? (
                  <div class="qa-list" aria-label={`${member.name} interview`}>
                    {qaQuestions.map((question, questionIndex) => {
                      const answer = member.qa?.[question.id];
                      if (!answer) return null;
                      const answerId = `qa-${memberIndex}-${questionIndex}`;
                      return (
                        <details class="qa-item">
                          <summary class="qa-question" id={`${answerId}-summary`}>
                            <span class="qa-question-text">{question.question}</span>
                            <span class="qa-chevron" aria-hidden="true"></span>
                          </summary>
                          <div class="qa-answer" id={answerId}>{answer}</div>
                        </details>
                      );
                    })}
                  </div>
                ) : (
                  <p class="pending-note">Interview answers coming soon.</p>
                )}
              </div>
            </article>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <Footer />
</BaseLayout>
