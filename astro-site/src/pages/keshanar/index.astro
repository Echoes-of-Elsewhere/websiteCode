---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import HeroSection from '../../components/HeroSection.astro';
import { keshanarCharacters, keshanarScenes, roll20Link } from '../../data/keshanar';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Keshanar Resources | Echoes of Elsewhere"
  description="Pre-generated Keshanar characters, encounter maps, and Roll20 resources for Echoes of Elsewhere."
>
  <Nav />

  <main id="main-content">
    <HeroSection compact>
      <div class="eyebrow">Player Resources</div>
      <h1>Keshanar</h1>
      <p class="lede">
        Use the configured Roll20 game or bring these pre-generated 3rd-level characters and
        encounter references to the table.
      </p>
      <div class="hero-actions">
        <a class="button" href={roll20Link} target="_blank" rel="noopener">Join on Roll20</a>
      </div>
    </HeroSection>

    <div class="shell resource-banner" data-reveal>
      <img src={`${base}images/keshanar/keshanar-banner.jpg`} alt="The Kingdom of Keshanar" width="1280" height="640" loading="lazy" />
    </div>

    <section class="shell resource-section">
      <div class="section-heading" data-reveal>
        <h2>Start with a character</h2>
      </div>
      <div class="resource-grid mt-1-4">
        {keshanarCharacters.map((character) => (
          <article class="card resource-card" data-reveal>
            <div class="pill">3rd-level pregenerated character</div>
            <h3>{character.name}</h3>
            <p class="resource-meta">{character.classLine}</p>
            <p>{character.familyConnection}</p>
            <a class="button secondary" href={`${base}keshanar/${character.slug}`}>View {character.name}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="shell resource-section">
      <div class="section-heading" data-reveal>
        <h2>Encounter maps</h2>
      </div>
      <div class="resource-grid resource-grid-scenes mt-1-4">
        {keshanarScenes.map((scene) => (
          <article class="card resource-card scene-card" data-reveal>
            <div class="pill">Scene reference</div>
            <h3>{scene.name}</h3>
            <a class="button secondary" href={`${base}keshanar/${scene.slug}`}>View map</a>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
