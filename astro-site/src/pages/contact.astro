---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection.astro';
import { siteLinks } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Community | Echoes of Elsewhere"
  description="Find the verified social, video, Patreon, and community links for Echoes of Elsewhere."
  bodyClass="page-contact"
>
  <Nav />

  <main id="main-content">
    <HeroSection compact>
      <div class="eyebrow">Keep in Touch</div>
      <h1>Find the Community</h1>
      <p class="lede">
        Follow the show, find new episodes, and join the conversation through the links below.
      </p>
    </HeroSection>

    <section class="shell" id="social">
      <div class="section-heading" data-reveal>
        <h2>Verified community links</h2>
      </div>
      <div class="grid cols-3 mt-1-4">
        <article class="card" data-reveal>
          <h3>YouTube</h3>
          <p>Episodes, actual play video, and the full playlist.</p>
          <div class="hero-actions mt-1">
            <a class="button secondary" href={siteLinks.youtube} target="_blank" rel="noopener">Roll To Discover</a>
          </div>
        </article>
        <article class="card" data-reveal>
          <h3>Patreon</h3>
          <p>Join the free tier for events, bonus content, and updates.</p>
          <div class="hero-actions mt-1">
            <a class="button secondary" href={siteLinks.patreon} target="_blank" rel="noopener">Echoes of Elsewhere</a>
          </div>
        </article>
        <article class="card" data-reveal>
          <h3>X</h3>
          <p>Announcements and episode updates from @EOEAP.</p>
          <div class="hero-actions mt-1">
            <a class="button secondary" href={siteLinks.x} target="_blank" rel="noopener">@EOEAP</a>
          </div>
        </article>
        <article class="card" data-reveal>
          <h3>Instagram</h3>
          <p>Behind-the-scenes updates from @echoesofelsewhereap.</p>
          <div class="hero-actions mt-1">
            <a class="button secondary" href={siteLinks.instagram} target="_blank" rel="noopener">@echoesofelsewhereap</a>
          </div>
        </article>
        <article class="card" data-reveal>
          <h3>TikTok</h3>
          <p>Find short-form updates from @eoeap.</p>
          <div class="hero-actions mt-1">
            <a class="button secondary" href={siteLinks.tiktok} target="_blank" rel="noopener">@eoeap</a>
          </div>
        </article>
        <article class="card" data-reveal>
          <h3>Bluesky</h3>
          <p>Follow the show’s updates on Bluesky.</p>
          <div class="hero-actions mt-1">
            <a class="button secondary" href={siteLinks.bluesky} target="_blank" rel="noopener">@eoeap.bsky.social</a>
          </div>
        </article>
      </div>
    </section>

    <div class="portal-divider shell" aria-hidden="true"></div>

    <section class="shell" id="contact-form">
      <div class="section-heading" data-reveal>
        <h2>Direct contact</h2>
      </div>
      <article class="card contact-pending" data-reveal>
        <h3>Contact details coming soon</h3>
        <p>
          We are holding the form until it has a verified destination. In the meantime, Patreon
          and the social profiles above are the best ways to follow the show.
        </p>
        <div class="hero-actions mt-1-5">
          <a class="button secondary" href={base}>Back to Home</a>
          <a class="button" href={siteLinks.playlist} target="_blank" rel="noopener">Watch the playlist</a>
        </div>
      </article>
    </section>
  </main>

  <Footer />
</BaseLayout>
